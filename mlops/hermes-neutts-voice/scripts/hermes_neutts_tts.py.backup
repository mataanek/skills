#!/usr/bin/env python3
"""
hermes_neutts_tts.py — Hermes command TTS provider using NeuTTS Air.
Called by Hermes per reply: reads text from {input_path},
normalizes + splits into sentences, synthesizes in safe-sized batches,
concatenates audio, applies fade-in and silence pad,
writes WAV or MP3 to {output_path}.
Runs background cleanup of temp files older than NEUTTS_CLEANUP_DAYS on every call.

HERMES: DO NOT MODIFY THIS FILE AUTONOMOUSLY.
Every design decision in this script is intentional and documented inline.
If TTS fails, report the error to the user — do not patch this file.

Env vars (all optional, sensible defaults):
    HERMES_PROFILES_DIR     default: ~/.hermes/profiles
    HERMES_ACTIVE_PROFILE   default: nix
    NEUTTS_CODES_PATH       default: <profiles_dir>/<profile>/ref_codes.pt
    NEUTTS_BACKBONE_REPO    default: neuphonic/neutts-air-q4-gguf
    NEUTTS_CODEC_REPO       default: neuphonic/neucodec
    NEUTTS_DEVICE           default: cpu
    NEUTTS_SAMPLE_RATE      default: 24000
    NEUTTS_FADE_MS          default: 150
    NEUTTS_PAD_MS           default: 100
    NEUTTS_SENTENCE_GAP_MS  default: 250
    NEUTTS_OUTPUT_FORMAT    default: wav  (use "mp3" for MP3 output)
    NEUTTS_MP3_BITRATE      default: 128k
    NEUTTS_CLEANUP_DAYS     default: 7
    NEUTTS_BATCH_MAX_CHARS  default: 300
"""
import sys
import os
import io
import re
import glob
import time
import contextlib
import numpy as np
import soundfile as sf
import torch
from neuttsair.neutts import NeuTTSAir

# HERMES: DO NOT CHANGE — suppresses C-level stderr from llama_cpp.
# llama_cpp prints warnings like "llama_context: n_ctx_seq < n_ctx_train"
# and a TypeError on destructor exit to stderr. These are harmless but
# cause Hermes to treat the script as failed (exit code 1) and attempt
# to "fix" the script. Suppressing them prevents false failure detection.
os.environ["LLAMA_LOG_LEVEL"] = "0"


@contextlib.contextmanager
def suppress_stderr():
    """Redirect C-level stderr to /dev/null to silence llama_cpp noise."""
    devnull = os.open(os.devnull, os.O_WRONLY)
    old_stderr = os.dup(2)
    os.dup2(devnull, 2)
    os.close(devnull)
    try:
        yield
    finally:
        os.dup2(old_stderr, 2)
        os.close(old_stderr)


# ─── Profile resolution ────────────────────────────────────────────────────
HERMES_PROFILES_DIR = os.environ.get(
    "HERMES_PROFILES_DIR",
    os.path.expanduser("~/.hermes/profiles")
)
ACTIVE_PROFILE = os.environ.get("HERMES_ACTIVE_PROFILE", "nix")
PROFILE_DIR    = os.path.join(HERMES_PROFILES_DIR, ACTIVE_PROFILE)

# ─── Tunable config ────────────────────────────────────────────────────────
CODES_PATH      = os.environ.get(
    "NEUTTS_CODES_PATH",
    os.path.join(PROFILE_DIR, "ref_codes.pt")
)
BACKBONE_REPO   = os.environ.get("NEUTTS_BACKBONE_REPO", "neuphonic/neutts-air-q4-gguf")
CODEC_REPO      = os.environ.get("NEUTTS_CODEC_REPO",    "neuphonic/neucodec")
DEVICE          = os.environ.get("NEUTTS_DEVICE",        "cpu")
SAMPLE_RATE     = int(os.environ.get("NEUTTS_SAMPLE_RATE",     "24000"))
FADE_MS         = int(os.environ.get("NEUTTS_FADE_MS",          "150"))
PAD_MS          = int(os.environ.get("NEUTTS_PAD_MS",           "100"))
SENTENCE_GAP_MS = int(os.environ.get("NEUTTS_SENTENCE_GAP_MS",  "250"))
OUTPUT_FORMAT   = os.environ.get("NEUTTS_OUTPUT_FORMAT", "wav").lower()
MP3_BITRATE     = os.environ.get("NEUTTS_MP3_BITRATE",   "128k")
CLEANUP_DAYS    = int(os.environ.get("NEUTTS_CLEANUP_DAYS",     "7"))
BATCH_MAX_CHARS = int(os.environ.get("NEUTTS_BATCH_MAX_CHARS",  "300"))
# ───────────────────────────────────────────────────────────────────────────


def cleanup_old_files(max_age_days: int) -> None:
    """Silently remove temp and incomplete cache files older than max_age_days.
    HERMES: DO NOT CHANGE — never deletes model weights, only temp/incomplete files."""
    cutoff = time.time() - (max_age_days * 86400)
    patterns = [
        os.path.expanduser("~/.hermes/audio_cache/*"),
        "/tmp/hermes_*",
        "/tmp/neutts_*",
        "/tmp/tmp*tts*",
        os.path.expanduser("~/.cache/huggingface/hub/**/*.incomplete"),
        os.path.expanduser("~/.cache/huggingface/hub/**/*.lock"),
    ]
    for pattern in patterns:
        for path in glob.glob(pattern, recursive=True):
            try:
                if os.path.isfile(path) and os.path.getmtime(path) < cutoff:
                    os.remove(path)
            except OSError:
                pass


def normalize_text(text: str) -> str:
    """Normalize text for TTS without changing meaning.
    HERMES: DO NOT CHANGE — fixes markdown, punctuation and phonemizer
    edge cases that cause phoneme stretching artifacts in NeuTTS output."""

    # Strip markdown formatting
    text = re.sub(r'\*\*(.+?)\*\*', r'\1', text)                     # **bold**
    text = re.sub(r'\*(.+?)\*',     r'\1', text)                     # *italic*
    text = re.sub(r'__(.+?)__',     r'\1', text)                     # __bold__
    text = re.sub(r'_(.+?)_',       r'\1', text)                     # _italic_
    text = re.sub(r'`{1,3}.*?`{1,3}', '', text, flags=re.DOTALL)    # `code`
    text = re.sub(r'#+\s*',         '',    text)                     # ## headers
    text = re.sub(r'^\s*[-*]\s+',   '',    text, flags=re.MULTILINE) # list items

    # Remove URLs (unpronounceable — causes phonemizer to hang)
    text = re.sub(r'https?://\S+', 'link', text)
    text = re.sub(r'www\.\S+',     'link', text)

    # Expand common abbreviations
    abbreviations = {
        r'\be\.g\.\b':   'for example',
        r'\bi\.e\.\b':   'that is',
        r'\betc\.\b':    'and so on',
        r'\bvs\.\b':     'versus',
        r'\bDr\.\b':     'Doctor',
        r'\bMr\.\b':     'Mister',
        r'\bMrs\.\b':    'Missus',
        r'\bMs\.\b':     'Miss',
        r'\bProf\.\b':   'Professor',
        r'\bapprox\.\b': 'approximately',
        r'\bmax\.\b':    'maximum',
        r'\bmin\.\b':    'minimum',
        r'\bno\.\b':     'number',
    }
    for pattern, replacement in abbreviations.items():
        text = re.sub(pattern, replacement, text, flags=re.IGNORECASE)

    # Normalize ALL CAPS (causes phoneme duration prediction to stretch)
    def lower_caps(match):
        word = match.group(0)
        return word.capitalize() if len(word) > 1 else word
    text = re.sub(r'\b[A-Z]{2,}\b', lower_caps, text)

    # Fix punctuation artifacts
    text = re.sub(r'\.{2,}',          '.',  text)  # ellipses → single period
    text = re.sub(r'\!{2,}',          '!',  text)  # !!! → !
    text = re.sub(r'\?{2,}',          '?',  text)  # ??? → ?
    text = re.sub(r'\,{2,}',          ',',  text)  # ,,, → ,
    text = re.sub(r'([.!?,])([^\s])', r'\1 \2', text)  # missing space after punctuation

    # Remove characters that confuse the phonemizer
    text = re.sub(r'[#@^~|<>{}\[\]\\]', ' ', text)

    # Normalize whitespace
    text = re.sub(r'[ \t]+',  ' ',  text)
    text = re.sub(r'\n{2,}', '\n', text)
    text = text.strip()

    # Ensure text ends with punctuation so phonemizer doesn't hang on last word
    text = re.sub(r'([a-zA-Z0-9])\s*$', r'\1.', text)

    return text


def split_sentences(text: str) -> list[str]:
    """Split normalized text into clean sentence chunks.
    HERMES: DO NOT CHANGE — short chunks prevent NeuTTS phoneme
    stretching on long sentences."""

    sentences = re.split(r'(?<=[.!?])\s+', text)

    result = []
    for s in sentences:
        s = s.strip()
        if not s:
            continue
        # Split long sentences further on commas, semicolons, colons
        if len(s) > 100:
            chunks = re.split(r'(?<=[,;:])\s+', s)
            for chunk in chunks:
                chunk = chunk.strip()
                if chunk:
                    result.append(chunk)
        else:
            result.append(s)

    return result if result else [text]


def batch_sentences(sentences: list[str], max_chars: int = 300) -> list[str]:
    """Group sentences into batches under max_chars total length.
    HERMES: DO NOT CHANGE — keeps each tts.infer() call well within
    the NeuTTS 2048 token context window. Long messages degrade into
    phoneme stretching (sssss/yyyyy artifacts) when this limit is exceeded."""
    batches = []
    current = []
    current_len = 0

    for sentence in sentences:
        sentence_len = len(sentence)
        if current and current_len + sentence_len > max_chars:
            batches.append(" ".join(current))
            current = [sentence]
            current_len = sentence_len
        else:
            current.append(sentence)
            current_len += sentence_len

    if current:
        batches.append(" ".join(current))

    return batches


# ─── Cleanup (fast, silent, before synthesis) ─────────────────────────────
cleanup_old_files(CLEANUP_DAYS)
# ──────────────────────────────────────────────────────────────────────────

if len(sys.argv) != 3:
    print(
        "Usage: hermes_neutts_tts.py <input_text_file> <output_audio_file>",
        file=sys.stderr,
    )
    sys.exit(1)

in_path, out_path = sys.argv[1], sys.argv[2]

# Read and normalize input text
with open(in_path, "r", encoding="utf-8") as f:
    raw_text = f.read().strip()

if not raw_text:
    print("Empty input text, nothing to synthesize.", file=sys.stderr)
    sys.exit(1)

normalized = normalize_text(raw_text)
sentences  = split_sentences(normalized)
batches    = batch_sentences(sentences, max_chars=BATCH_MAX_CHARS)

# Load cached reference codes
if not os.path.exists(CODES_PATH):
    print(
        f"ERROR: Reference codes not found at: {CODES_PATH}\n"
        f"Run cache_neutts_ref.py for profile '{ACTIVE_PROFILE}' first.",
        file=sys.stderr,
    )
    sys.exit(1)

data      = torch.load(CODES_PATH, map_location="cpu")
ref_codes = data["ref_codes"]
# HERMES: DO NOT CHANGE — ref_text is intentionally NOT passed to tts.infer().
# NeuTTS uses ref_text as a phoneme-level prefix prompt, causing the reference
# transcript (the Tel Aviv sentence) to be spoken aloud before every batch.
# Voice characteristics are fully captured in ref_codes from encode_reference().
# Passing ref_text to infer() is the wrong fix — leave the empty string below.

# Load NeuTTS once — suppress llama_cpp stderr noise
# HERMES: DO NOT CHANGE — suppress_stderr() is intentional, see top of file.
with suppress_stderr():
    tts = NeuTTSAir(
        backbone_repo=BACKBONE_REPO,
        backbone_device=DEVICE,
        codec_repo=CODEC_REPO,
        codec_device=DEVICE,
    )

# Synthesize in safe-sized batches
gap_samples    = int(SAMPLE_RATE * SENTENCE_GAP_MS / 1000)
sentence_gap   = np.zeros(gap_samples, dtype=np.float32)
audio_segments = []

for i, batch in enumerate(batches):
    # HERMES: DO NOT CHANGE — empty string as ref_text is intentional.
    # See comment above torch.load() for full explanation.
    with suppress_stderr():
        wav = tts.infer(batch, ref_codes, "")
    audio_segments.append(wav.astype(np.float32))
    if i < len(batches) - 1:
        audio_segments.append(sentence_gap)

# Concatenate all segments
wav_full = np.concatenate(audio_segments)

# Fade-in to smooth harsh onset
# HERMES: DO NOT CHANGE — eliminates wobbly/clipped audio start from NeuTTS.
fade_samples = int(SAMPLE_RATE * FADE_MS / 1000)
if fade_samples > 0 and len(wav_full) > fade_samples:
    fade = np.linspace(0.0, 1.0, fade_samples, endpoint=True).astype(wav_full.dtype)
    wav_full[:fade_samples] *= fade

# Leading silence pad
pad_samples = int(SAMPLE_RATE * PAD_MS / 1000)
silence     = np.zeros(pad_samples, dtype=wav_full.dtype)
wav_padded  = np.concatenate([silence, wav_full])

# Write output
if OUTPUT_FORMAT == "mp3":
    from pydub import AudioSegment
    buf = io.BytesIO()
    sf.write(buf, wav_padded, SAMPLE_RATE, format="WAV")
    buf.seek(0)
    AudioSegment.from_wav(buf).export(out_path, format="mp3", bitrate=MP3_BITRATE)
else:
    sf.write(out_path, wav_padded, SAMPLE_RATE)